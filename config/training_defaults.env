REM GPU-parallel RL defaults for RTX 5060 Laptop (~8 GB VRAM)
REM Edit these before running scripts/*.bat

ISAACLAB_DIR=C:\Isaac\IsaacLab
VENV_DIR=C:\Isaac\env_isaaclab

REM Legacy paths (too long for Isaac Sim extscache on some Windows setups):
REM ISAACLAB_DIR=IsaacLab
REM VENV_DIR=env_isaaclab

REM Locomotion: Isaac-Velocity-Flat-Anymal-C-v0
LOCOMOTION_TASK=Isaac-Velocity-Flat-Anymal-C-v0
LOCOMOTION_PLAY_TASK=Isaac-Velocity-Flat-Anymal-C-Play-v0
LOCOMOTION_NUM_ENVS=128
LOCOMOTION_MAX_ITERATIONS=1500

REM Rough terrain locomotion (heavier — lower num_envs on 8 GB)
ROUGH_LOCOMOTION_TASK=Isaac-Velocity-Rough-Anymal-C-v0
ROUGH_LOCOMOTION_PLAY_TASK=Isaac-Velocity-Rough-Anymal-C-Play-v0
ROUGH_LOCOMOTION_NUM_ENVS=64
ROUGH_LOCOMOTION_MAX_ITERATIONS=1000

REM Manipulation: Isaac-Reach-Franka-v0
MANIPULATION_TASK=Isaac-Reach-Franka-v0
MANIPULATION_PLAY_TASK=Isaac-Reach-Franka-Play-v0
MANIPULATION_NUM_ENVS=128
MANIPULATION_MAX_ITERATIONS=1000

REM Shared
SEED=0
PLAY_NUM_ENVS=32
